  "narrative": {
    "northStar": "The Bazaar Street",
    "overview": "The page is a lime-washed wall in a Bengal market lane, hung with enamel tin signboards. Every section is a board on two chains, lettered by a sign painter, in the saturated colours real shopfronts use. Density alternates like a real street; type does the decorating.",
    "keyCharacteristics": [
      "Cool limewash ground, never cream.",
      "Full palette: six enamel colours each own whole boards, not accents.",
      "Sign-painter display lettering with a hard drop shade in a darker tone of the board.",
      "Boards hang on chains and move with real spring physics.",
      "A rubber stamp marks what has been visited."
    ],
    "rules": [
      {
        "name": "The Whole Board Rule",
        "body": "A colour is spent on a whole board or plaque, never scattered as small accents on a neutral card.",
        "section": "colors"
      },
      {
        "name": "The Ink Pairing Rule",
        "body": "Yellow and white boards take Board Ink lettering; vermilion, teal, green, ultramarine and pink take Enamel White.",
        "section": "colors"
      },
      {
        "name": "The Painter's Shade Rule",
        "body": "Display lettering carries a hard drop shade in a darker tone of the board. This is the world's native device, not a costume shadow.",
        "section": "typography"
      },
      {
        "name": "The Caption Below Rule",
        "body": "A sign's plain-language label sits under its lettering, never above it as an eyebrow.",
        "section": "typography"
      },
      {
        "name": "The Lit Sign Rule",
        "body": "Section signs start dim and light to full colour with the stamp when reached.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give every new section a hanging sign with a plain-language caption below it.",
      "Do paint whole boards in one enamel tone and pair text per the Ink Pairing Rule.",
      "Do let lettering carry the decoration; reuse chains, rivets, bunting and stamps before inventing ornaments.",
      "Do keep every motion behind prefers-reduced-motion."
    ],
    "donts": [
      "Don't warm the wall toward cream or parchment; the ground stays cool limewash (#eef3f4).",
      "Don't put an uppercase eyebrow label above a heading.",
      "Don't use zero-blur block shadows on boxes; the only hard shadow is the painter's shade on lettering.",
      "Don't use pure black (#000) for text or grounds; use Board Ink (#15130f).",
      "Don't use emoji or Unicode glyphs as icons; icons come from lucide at one stroke weight."
    ]
  }
